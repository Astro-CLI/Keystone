# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore common editor and IDE folders
.vscode/
.idea/

# Ignore temporary files
*.tmp
*.bak
*.swp
*.swo

# Ignore log files
*.log
id_ed25519*

# Ignore Python bytecode/cache artifacts
__pycache__/
*.py[cod]

# Ignore local Packet Tracer/exported artifacts
*.pkt
*.zip
